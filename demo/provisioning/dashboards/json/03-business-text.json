     "rawSql": "SELECT host, round(avg(cpu),1) AS avg_cpu, round(max(cpu),1) AS max_cpu, round(avg(mem),1) AS avg_mem FROM demo.metrics WHERE $__timeFilter(ts) GROUP BY host ORDER BY host",
