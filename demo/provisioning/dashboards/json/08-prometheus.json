{
 "uid": "prometheus",
 "title": "08 Prometheus",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "tags": [
  "demo"
 ],
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Targets up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(up)",
     "legendFormat": "up",
     "range": true,
     "instant": false
    }
   ],
   "description": "",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "stat",
   "title": "TSDB head series",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "prometheus_tsdb_head_series",
     "legendFormat": "series",
     "range": true,
     "instant": false
    }
   ],
   "description": "",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Prometheus HTTP requests/s by handler",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (handler) (rate(prometheus_http_requests_total[1m]))",
     "legendFormat": "{{handler}}",
     "range": true,
     "instant": false
    }
   ],
   "description": "",
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Resident memory by job (Prometheus)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "process_resident_memory_bytes",
